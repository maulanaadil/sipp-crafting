# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/sippp_next
SESSION_SECRET=CHANGE_ME_to_at_least_32_random_characters
# RKPD year the pendampingan spreadsheets belong to (sheets say "Tahun 2026", data is tahun=2027)
INJECT_TAHUN=2027
# Fuzzy-resolution backend: "rules" (local trigram, default) | "none". No LLM provider is wired.
INJECT_SUGGESTER=rules
# Local super-admin created by `npm run db:seed`
DEV_ADMIN_USERNAME=inject_dev
DEV_ADMIN_PASSWORD=inject123
